{%- comment -%}
  ============================================================
  AV ANIMATIONS
  Global scroll-reveal + motion system. Rendered once in
  theme.liquid before </body>.

  Usage: add class "av-reveal" (optionally with a stagger via
  style="--av-delay: 120ms") to any element. It fades/slides in
  when scrolled into view.

  Robustness:
  - Hidden state is scoped under `.js` (Dawn swaps html.no-js → js),
    so with JS disabled everything stays visible.
  - Respects prefers-reduced-motion.
  ============================================================
{%- endcomment -%}

<style>
  /* Only hide-before-reveal when JS is active and motion is allowed */
  @media (prefers-reduced-motion: no-preference) {
    .js .av-reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--av-delay, 0ms);
      will-change: opacity, transform;
    }
    .js .av-reveal.av-in {
      opacity: 1;
      transform: none;
    }

    /* Variant: scale-in (for images/cards) */
    .js .av-reveal--zoom { transform: translateY(28px) scale(0.97); }
    .js .av-reveal--zoom.av-in { transform: none; }

    /* Subtle continuous float for hero accents */
    @keyframes av-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
  }
</style>

<script>
(function () {
  'use strict';

  function reveal() {
    const els = document.querySelectorAll('.av-reveal:not(.av-in)');
    if (!els.length) return;

    if (!('IntersectionObserver' in window)) {
      // No IO support — just show everything.
      els.forEach((el) => el.classList.add('av-in'));
      return;
    }

    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('av-in');
            obs.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );

    els.forEach((el) => io.observe(el));

    // Safety net: if IO callbacks are throttled (some embedded
    // contexts), reveal anything already in the viewport on scroll.
    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        document.querySelectorAll('.av-reveal:not(.av-in)').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight * 0.92 && r.bottom > 0) {
            el.classList.add('av-in');
          }
        });
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', reveal);
  } else {
    reveal();
  }

  // Re-scan when sections are re-rendered in the theme editor.
  document.addEventListener('shopify:section:load', reveal);
})();
</script>
