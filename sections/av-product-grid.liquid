{%- comment -%}
  AV PRODUCT GRID SECTION
  Editorial product cards: image zoom, hover quick-add pill, staggered reveal.
  Falls back to curated Unsplash lifestyle images when products have no photo.
{%- endcomment -%}

{%- assign grid_collection = collections[section.settings.collection] -%}
{%- assign products_to_show = section.settings.products_to_show -%}

{%- assign fallback_images = 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab,https://images.unsplash.com/photo-1596755094514-f87e34085b2c,https://images.unsplash.com/photo-1620799140408-edc6dcb6d633,https://images.unsplash.com/photo-1618354691373-d851c5c3a990,https://images.unsplash.com/photo-1576566588028-4147f3842f27,https://images.unsplash.com/photo-1593030761757-71fae45fa0e7,https://images.unsplash.com/photo-1622445275576-721325763afe,https://images.unsplash.com/photo-1558769132-cb1aea458c5e' | split: ',' -%}

{%- style -%}
  #av-pg-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: rgb(var(--color-background));
  }
  #av-pg-{{ section.id }} .av-pg__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }
  #av-pg-{{ section.id }} .av-pg__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 5.6rem;
  }
  #av-pg-{{ section.id }} .av-pg__eyebrow {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--av-accent, rgba(var(--color-foreground),0.4));
    margin-bottom: 1rem;
  }
  #av-pg-{{ section.id }} .av-pg__heading {
    font-family: var(--av-font-heading, Georgia, serif) !important;
    font-size: clamp(3rem, 4.5vw, 5.4rem);
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin: 0 0 0.8rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  #av-pg-{{ section.id }} .av-pg__subheading {
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.55);
    margin: 0;
    font-weight: 300;
  }

  /* Grid */
  #av-pg-{{ section.id }} .av-pg__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.8rem 2rem;
  }

  /* Card */
  #av-pg-{{ section.id }} .av-pg__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  #av-pg-{{ section.id }} .av-pg__card-img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--av-radius-card, 4px);
    background: rgba(var(--color-foreground), 0.05);
    aspect-ratio: 3 / 4;
  }
  #av-pg-{{ section.id }} .av-pg__card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22,1,0.36,1);
  }
  #av-pg-{{ section.id }} .av-pg__card:hover .av-pg__card-img-wrap img {
    transform: scale(1.07);
  }

  /* Quick-add pill — appears on hover */
  #av-pg-{{ section.id }} .av-pg__quick-add {
    position: absolute;
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    white-space: nowrap;
    padding: 0.9rem 2.2rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.95);
    color: #0d0d0d;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    z-index: 2;
    backdrop-filter: blur(4px);
  }
  #av-pg-{{ section.id }} .av-pg__card:hover .av-pg__quick-add {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  #av-pg-{{ section.id }} .av-pg__quick-add:hover {
    box-shadow: 0 8px 28px rgba(0,0,0,0.28);
    background: #fff;
  }

  /* Wishlist badge */
  #av-pg-{{ section.id }} .av-pg__badge {
    position: absolute;
    top: 1.2rem;
    left: 1.2rem;
    z-index: 2;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 0.4rem 1rem;
    border-radius: 100px;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  /* Info */
  #av-pg-{{ section.id }} .av-pg__card-info {
    padding: 1.8rem 0 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  #av-pg-{{ section.id }} .av-pg__card-vendor {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(var(--color-foreground), 0.4);
    font-weight: 500;
  }
  #av-pg-{{ section.id }} .av-pg__card-title {
    font-size: 1.5rem;
    font-weight: 500;
    color: rgb(var(--color-foreground));
    line-height: 1.4;
    margin: 0;
  }
  #av-pg-{{ section.id }} .av-pg__card-price {
    font-size: 1.45rem;
    color: rgba(var(--color-foreground), 0.75);
    margin-top: 0.2rem;
    font-weight: 400;
  }
  #av-pg-{{ section.id }} .av-pg__card-price s {
    color: rgba(var(--color-foreground), 0.35);
    margin-right: 0.6rem;
    text-decoration: line-through;
  }
  #av-pg-{{ section.id }} .av-pg__card-sale {
    color: #c0392b;
    font-weight: 600;
  }

  /* View all */
  #av-pg-{{ section.id }} .av-pg__footer {
    text-align: center;
    margin-top: 5.6rem;
  }
  #av-pg-{{ section.id }} .av-pg__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.4rem 4rem;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid rgba(var(--color-foreground), 0.3);
    color: rgb(var(--color-foreground));
    border-radius: var(--av-radius-pill, 100px);
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  #av-pg-{{ section.id }} .av-pg__view-all:hover {
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    border-color: rgb(var(--color-foreground));
  }

  @media (max-width: 989px) {
    #av-pg-{{ section.id }} .av-pg__grid { grid-template-columns: repeat(2,1fr); gap: 2rem 1.4rem; }
  }
  @media (max-width: 480px) {
    #av-pg-{{ section.id }} .av-pg__grid { gap: 1.6rem 1rem; }
    #av-pg-{{ section.id }} .av-pg__quick-add { display: none; }
  }
{%- endstyle -%}

<section id="av-pg-{{ section.id }}" class="av-product-grid-section">
  <div class="av-pg__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="av-pg__header av-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="av-pg__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="av-pg__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="av-pg__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if grid_collection != blank and grid_collection.products_count > 0 -%}
      <div class="av-pg__grid">
        {%- for product in grid_collection.products limit: products_to_show -%}
          {%- assign fb_index = forloop.index0 | modulo: fallback_images.size -%}
          {%- assign fb_url = fallback_images[fb_index] | append: '?auto=format&fit=crop&w=600&h=800&q=80' -%}
          <a class="av-pg__card av-reveal av-reveal--zoom" href="{{ product.url }}" style="--av-delay: {{ forloop.index0 | times: 70 }}ms">
            <div class="av-pg__card-img-wrap">
              {%- if product.compare_at_price > product.price -%}
                <span class="av-pg__badge">Sale</span>
              {%- endif -%}
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    width: product.featured_image.width,
                    height: product.featured_image.height,
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '300,450,600,700',
                    alt: product.featured_image.alt | default: product.title | escape
                }}
              {%- else -%}
                <img src="{{ fb_url }}" alt="{{ product.title | escape }}" width="600" height="800" loading="lazy">
              {%- endif -%}
              {%- if product.available -%}
                <button
                  class="av-pg__quick-add"
                  onclick="event.preventDefault(); event.stopPropagation(); fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:{{ product.first_available_variant.id }},quantity:1})}).then(()=>{ document.dispatchEvent(new CustomEvent('cart:refresh')); this.textContent='Added ✓'; setTimeout(()=>this.textContent='Quick Add',1400); }).catch(()=>this.textContent='View →');"
                  aria-label="Add {{ product.title | escape }} to cart"
                >Quick Add</button>
              {%- endif -%}
            </div>
            <div class="av-pg__card-info">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <p class="av-pg__card-vendor">{{ product.vendor | escape }}</p>
              {%- endif -%}
              <p class="av-pg__card-title">{{ product.title | escape }}</p>
              <div class="av-pg__card-price">
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                  <span class="av-pg__card-sale">{{ product.price | money }}</span>
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="av-pg__footer av-reveal">
          <a class="av-pg__view-all" href="{{ grid_collection.url }}">
            View all {{ grid_collection.title }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="av-pg__grid">
        {%- for i in (1..4) -%}
          <div class="av-pg__card">
            <div class="av-pg__card-img-wrap">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
            <div class="av-pg__card-info">
              <p class="av-pg__card-title">Sample Product {{ i }}</p>
              <div class="av-pg__card-price">₱0.00</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AV Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Edit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handpicked favorites, just for you"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4, "max": 16, "step": 4,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    { "name": "AV Product Grid" }
  ]
}
{% endschema %}
