{%- comment -%}
  ============================================================
  AV PRODUCT GRID SECTION
  Shows products from a selected collection in a clean grid.
  4 columns on desktop, 2 on mobile. Minimal card design.

  Skills: collection object, product loops, image_url filter,
  money filter, responsive CSS Grid, lazy loading.
  ============================================================
{%- endcomment -%}

{%- assign grid_collection = collections[section.settings.collection] -%}
{%- assign products_to_show = section.settings.products_to_show -%}

{%- style -%}
  #av-pg-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: rgb(var(--color-background));
  }

  #av-pg-{{ section.id }} .av-pg__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  #av-pg-{{ section.id }} .av-pg__header {
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 4rem;
  }

  #av-pg-{{ section.id }} .av-pg__heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin: 0 0 0.8rem;
  }

  #av-pg-{{ section.id }} .av-pg__subheading {
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  /* 4-column grid on desktop */
  #av-pg-{{ section.id }} .av-pg__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.4rem;
  }

  /* Product card */
  #av-pg-{{ section.id }} .av-pg__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    group: card;
  }

  #av-pg-{{ section.id }} .av-pg__card-image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--card-corner-radius, 0px);
    background-color: rgba(var(--color-foreground), 0.04);
    aspect-ratio: 1 / 1;
  }

  #av-pg-{{ section.id }} .av-pg__card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  #av-pg-{{ section.id }} .av-pg__card:hover .av-pg__card-image-wrap img {
    transform: scale(1.04);
  }

  /* Placeholder when no image */
  #av-pg-{{ section.id }} .av-pg__card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(var(--color-foreground), 0.2);
  }

  #av-pg-{{ section.id }} .av-pg__card-info {
    padding: 1.4rem 0 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  #av-pg-{{ section.id }} .av-pg__card-vendor {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(var(--color-foreground), 0.5);
  }

  #av-pg-{{ section.id }} .av-pg__card-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    line-height: 1.4;
    margin: 0;
  }

  #av-pg-{{ section.id }} .av-pg__card-price {
    font-size: 1.5rem;
    color: rgb(var(--color-foreground));
    margin-top: 0.4rem;
  }

  #av-pg-{{ section.id }} .av-pg__card-price s {
    color: rgba(var(--color-foreground), 0.45);
    margin-right: 0.6rem;
  }

  #av-pg-{{ section.id }} .av-pg__card-sale-badge {
    display: inline-block;
    font-size: 1.1rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    margin-left: 0.4rem;
    vertical-align: middle;
  }

  #av-pg-{{ section.id }} .av-pg__view-all {
    text-align: center;
    margin-top: 4rem;
  }

  #av-pg-{{ section.id }} .av-pg__view-all a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1.2rem 3.2rem;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    border: 2px solid rgb(var(--color-foreground));
    color: rgb(var(--color-foreground));
    border-radius: var(--buttons-radius, 0);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  #av-pg-{{ section.id }} .av-pg__view-all a:hover {
    background-color: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  /* Tablet: 2 columns */
  @media screen and (max-width: 989px) {
    #av-pg-{{ section.id }} .av-pg__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.6rem;
    }
  }

  /* Mobile: 2 columns (keep 2-up for compact browsing) */
  @media screen and (max-width: 749px) {
    #av-pg-{{ section.id }} .av-pg__grid {
      gap: 1.2rem;
    }
    #av-pg-{{ section.id }} .av-pg__card-title {
      font-size: 1.4rem;
    }
  }
{%- endstyle -%}

<section id="av-pg-{{ section.id }}" class="av-product-grid-section">
  <div class="av-pg__inner">

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="av-pg__header av-reveal">
        {%- if section.settings.heading != blank -%}
          <h2 class="av-pg__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="av-pg__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Curated apparel images shown when a product has no photo yet,
      so the grid looks populated. Cycles by loop index.
    {%- endcomment -%}
    {%- assign fallback_images = 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab,https://images.unsplash.com/photo-1596755094514-f87e34085b2c,https://images.unsplash.com/photo-1620799140408-edc6dcb6d633,https://images.unsplash.com/photo-1618354691373-d851c5c3a990,https://images.unsplash.com/photo-1576566588028-4147f3842f27,https://images.unsplash.com/photo-1593030761757-71fae45fa0e7,https://images.unsplash.com/photo-1622445275576-721325763afe,https://images.unsplash.com/photo-1556905055-8f358a7a47b2' | split: ',' -%}

    {%- if grid_collection != blank and grid_collection.products_count > 0 -%}
      <div class="av-pg__grid">
        {%- for product in grid_collection.products limit: products_to_show -%}
          <a class="av-pg__card av-reveal av-reveal--zoom" href="{{ product.url }}" style="--av-delay: {{ forloop.index0 | times: 80 }}ms">

            <div class="av-pg__card-image-wrap">
              {%- if product.featured_image -%}
                {{
                  product.featured_image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    width: product.featured_image.width,
                    height: product.featured_image.height,
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '300, 400, 600',
                    alt: product.featured_image.alt | default: product.title | escape
                }}
              {%- else -%}
                {%- assign fb_index = forloop.index0 | modulo: fallback_images.size -%}
                {%- assign fb_url = fallback_images[fb_index] | append: '?auto=format&fit=crop&w=600&h=600&q=80' -%}
                <img
                  src="{{ fb_url }}"
                  alt="{{ product.title | escape }}"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {%- endif -%}
            </div>

            <div class="av-pg__card-info">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <p class="av-pg__card-vendor">{{ product.vendor | escape }}</p>
              {%- endif -%}

              <p class="av-pg__card-title">{{ product.title | escape }}</p>

              <div class="av-pg__card-price">
                {%- if product.compare_at_price > product.price -%}
                  <s>{{ product.compare_at_price | money }}</s>
                  {{ product.price | money }}
                  <span class="av-pg__card-sale-badge">Sale</span>
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </div>
            </div>

          </a>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and grid_collection.products_count > products_to_show -%}
        <div class="av-pg__view-all">
          <a href="{{ grid_collection.url }}">
            View all {{ grid_collection.title }} &rarr;
          </a>
        </div>
      {%- endif -%}

    {%- else -%}
      {%- comment -%} Placeholder grid shown in customizer when no collection is selected {%- endcomment -%}
      <div class="av-pg__grid">
        {%- for i in (1..4) -%}
          <div class="av-pg__card">
            <div class="av-pg__card-image-wrap">
              {{ 'product-' | append: i | placeholder_svg_tag }}
            </div>
            <div class="av-pg__card-info">
              <p class="av-pg__card-title">Sample Product {{ i }}</p>
              <div class="av-pg__card-price">$0.00</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "AV Product Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop Our Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Handpicked favorites just for you"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "AV Product Grid"
    }
  ]
}
{% endschema %}
