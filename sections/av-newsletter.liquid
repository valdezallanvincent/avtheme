{%- comment -%}
  AV NEWSLETTER — full-width email capture with background image
  Integrates with Shopify's native /contact#contact_form endpoint.
{%- endcomment -%}

{%- assign has_bg = section.settings.bg_image_url | strip -%}

{%- style -%}
  #av-nl-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
    position: relative;
    overflow: hidden;
    text-align: center;
    {%- if has_bg != blank -%}
    background: #111;
    {%- else -%}
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    {%- endif -%}
  }
  {%- if has_bg != blank -%}
  #av-nl-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('{{ section.settings.bg_image_url }}');
    background-size: cover;
    background-position: center;
    opacity: 0.18;
  }
  {%- endif -%}
  #av-nl-{{ section.id }} .av-nl__inner {
    position: relative;
    z-index: 1;
    max-width: 62rem;
    margin: 0 auto;
  }
  #av-nl-{{ section.id }} .av-nl__eyebrow {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1.2rem;
  }
  #av-nl-{{ section.id }} .av-nl__heading {
    font-size: clamp(2.4rem, 4vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    color: #ffffff;
    margin: 0 0 1.2rem;
    letter-spacing: -0.01em;
  }
  #av-nl-{{ section.id }} .av-nl__subheading {
    font-size: 1.6rem;
    color: rgba(255,255,255,0.72);
    margin: 0 0 3.2rem;
    line-height: 1.6;
  }
  #av-nl-{{ section.id }} .av-nl__form {
    display: flex;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
  }
  #av-nl-{{ section.id }} .av-nl__input {
    flex: 1;
    padding: 1.4rem 1.8rem;
    font-size: 1.5rem;
    border: none;
    border-radius: var(--buttons-radius, 0);
    background: rgba(255,255,255,0.12);
    color: #ffffff;
    outline: none;
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.2);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  #av-nl-{{ section.id }} .av-nl__input::placeholder { color: rgba(255,255,255,0.45); }
  #av-nl-{{ section.id }} .av-nl__input:focus {
    background: rgba(255,255,255,0.18);
    border-color: rgba(255,255,255,0.5);
  }
  #av-nl-{{ section.id }} .av-nl__btn {
    padding: 1.4rem 2.8rem;
    font-size: 1.5rem;
    font-weight: 700;
    border: none;
    border-radius: var(--buttons-radius, 0);
    background: #ffffff;
    color: #111;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  #av-nl-{{ section.id }} .av-nl__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.28);
  }
  #av-nl-{{ section.id }} .av-nl__fine {
    font-size: 1.2rem;
    color: rgba(255,255,255,0.4);
    margin-top: 1.4rem;
  }
  #av-nl-{{ section.id }} .av-nl__success {
    display: none;
    font-size: 1.7rem;
    color: #4ade80;
    font-weight: 600;
    padding: 1.2rem;
  }
  @media (max-width: 580px) {
    #av-nl-{{ section.id }} .av-nl__form {
      flex-direction: column;
    }
    #av-nl-{{ section.id }} .av-nl__btn { width: 100%; }
  }
{%- endstyle -%}

<section id="av-nl-{{ section.id }}" class="av-newsletter-section">
  <div class="av-nl__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="av-nl__eyebrow av-reveal">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h2 class="av-nl__heading av-reveal" style="--av-delay: 60ms">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="av-nl__subheading av-reveal" style="--av-delay: 120ms">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="av-reveal" style="--av-delay: 180ms">
      {%- form 'customer', id: 'av-nl-form-{{ section.id }}' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="av-nl__form">
          <input
            class="av-nl__input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.placeholder | default: 'Your email address' | escape }}"
            required
            autocomplete="email"
            aria-label="{{ section.settings.placeholder | default: 'Your email address' | escape }}"
          >
          <button class="av-nl__btn" type="submit">{{ section.settings.button_label | default: 'Subscribe' | escape }}</button>
        </div>
      {%- endform -%}
      <p class="av-nl__fine">{{ section.settings.fine_print | default: 'No spam. Unsubscribe anytime.' | escape }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AV Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get early access to new drops"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe to our newsletter and be the first to know about exclusive offers, new arrivals, and style tips."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "No spam. Unsubscribe anytime."
    },
    {
      "type": "text",
      "id": "bg_image_url",
      "label": "Background image URL (optional)",
      "info": "Paste an Unsplash URL for a subtle background texture."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40, "max": 160, "step": 8, "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40, "max": 160, "step": 8, "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "AV Newsletter"
    }
  ]
}
{% endschema %}
