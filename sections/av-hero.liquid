{%- comment -%}
  ============================================================
  AV HERO SECTION
  Full-width hero with background image, headline, subheading,
  and a single CTA button. Fully editable in theme customizer.

  Skills: Liquid section schema, image_url filter, lazy loading
  control, CSS custom properties, responsive design.
  ============================================================
{%- endcomment -%}

{%- assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0 -%}

{%- style -%}
  #av-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_alignment }};
    overflow: hidden;
    padding: 6rem 2rem;
  }

  #av-hero-{{ section.id }} .av-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #av-hero-{{ section.id }} .av-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Dark overlay for text legibility */
  #av-hero-{{ section.id }} .av-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ overlay_opacity }});
    z-index: 1;
  }

  #av-hero-{{ section.id }} .av-hero__content {
    position: relative;
    z-index: 2;
    max-width: 80rem;
    text-align: {{ section.settings.content_alignment }};
    color: #ffffff;
  }

  #av-hero-{{ section.id }} .av-hero__heading {
    font-size: clamp(3.2rem, 6vw, 6.4rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1.6rem;
    letter-spacing: -0.02em;
  }

  #av-hero-{{ section.id }} .av-hero__subheading {
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    line-height: 1.6;
    margin: 0 0 3.2rem;
    opacity: 0.9;
  }

  #av-hero-{{ section.id }} .av-hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 1.4rem 3.2rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: opacity 0.2s ease, transform 0.2s ease;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: 2px solid transparent;
  }

  #av-hero-{{ section.id }} .av-hero__cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  /* No-image fallback: use color scheme background */
  #av-hero-{{ section.id }}.no-image {
    background-color: rgb(var(--color-background));
  }

  #av-hero-{{ section.id }}.no-image .av-hero__content {
    color: rgb(var(--color-foreground));
  }

  @media screen and (max-width: 749px) {
    #av-hero-{{ section.id }} {
      min-height: {{ section.settings.section_height | times: 0.7 | round }}px;
      padding: 4rem 2rem;
    }
  }
{%- endstyle -%}

<section
  id="av-hero-{{ section.id }}"
  class="av-hero-section{% unless section.settings.image %}no-image{% endunless %}"
  aria-label="{{ section.settings.heading | escape }}"
>

  {%- if section.settings.image -%}
    <div class="av-hero__bg">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000',
          class: 'av-hero__bg-img'
      }}
    </div>
    <div class="av-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="av-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="av-hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="av-hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="av-hero__cta" href="{{ section.settings.button_link }}">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>

</section>

{% schema %}
{
  "name": "AV Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (desktop)",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Your Style"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the latest collection — curated just for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "AV Hero"
    }
  ]
}
{% endschema %}
