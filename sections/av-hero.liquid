{%- comment -%}
  ============================================================
  AV HERO SECTION
  Full-width hero with background image, headline, subheading,
  and a single CTA button. Fully editable in theme customizer.

  Background priority:
  1. Uploaded image (image_picker) — Shopify CDN, optimized.
  2. External image URL (text setting) — handy for quick demos.
  3. Gradient fallback.

  Skills: Liquid schema, image_tag, lazy/eager loading,
  CSS custom properties, responsive design, motion.
  ============================================================
{%- endcomment -%}

{%- assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign has_picker = section.settings.image -%}
{%- assign has_url = section.settings.external_image_url | strip -%}

{%- style -%}
  #av-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.content_alignment }};
    overflow: hidden;
    padding: 6rem 2rem;
    {%- if has_picker == blank and has_url == blank -%}
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 55%, #0f3460 100%);
    {%- endif -%}
  }

  #av-hero-{{ section.id }} .av-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #av-hero-{{ section.id }} .av-hero__bg img,
  #av-hero-{{ section.id }} .av-hero__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  {%- if has_url != blank and has_picker == blank -%}
  #av-hero-{{ section.id }} .av-hero__bg {
    background-image: url('{{ section.settings.external_image_url }}');
    background-size: cover;
    background-position: center;
    /* slow zoom for life */
    animation: av-hero-zoom 18s ease-in-out infinite alternate;
  }
  @keyframes av-hero-zoom {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }
  {%- endif -%}

  #av-hero-{{ section.id }} .av-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(0,0,0,{{ overlay_opacity | times: 0.5 }}) 0%, rgba(0,0,0,{{ overlay_opacity }}) 100%);
  }

  #av-hero-{{ section.id }} .av-hero__content {
    position: relative;
    z-index: 2;
    max-width: 82rem;
    text-align: {{ section.settings.content_alignment }};
    color: {% if has_picker or has_url != blank %}#ffffff{% else %}#ffffff{% endif %};
  }

  #av-hero-{{ section.id }} .av-hero__eyebrow {
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 1.6rem;
    opacity: 0.85;
  }
  #av-hero-{{ section.id }} .av-hero__heading {
    font-size: clamp(3.4rem, 6.5vw, 7rem);
    font-weight: 700;
    line-height: 1.05;
    margin: 0 0 1.6rem;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 30px rgba(0,0,0,0.25);
  }
  #av-hero-{{ section.id }} .av-hero__subheading {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.6;
    margin: 0 auto 3.2rem;
    max-width: 56rem;
    opacity: 0.92;
  }
  {%- if section.settings.content_alignment != 'center' -%}
  #av-hero-{{ section.id }} .av-hero__subheading { margin-left: 0; margin-right: 0; }
  {%- endif -%}

  #av-hero-{{ section.id }} .av-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.5rem 3.6rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    background: #ffffff;
    color: #111111;
    border: 2px solid #ffffff;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, color 0.25s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.18);
  }
  #av-hero-{{ section.id }} .av-hero__cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.28);
    background: transparent;
    color: #ffffff;
  }
  #av-hero-{{ section.id }} .av-hero__cta svg { transition: transform 0.25s ease; }
  #av-hero-{{ section.id }} .av-hero__cta:hover svg { transform: translateX(4px); }

  @media screen and (max-width: 749px) {
    #av-hero-{{ section.id }} {
      min-height: {{ section.settings.section_height | times: 0.72 | round }}px;
      padding: 4rem 2rem;
    }
  }
{%- endstyle -%}

<section
  id="av-hero-{{ section.id }}"
  class="av-hero-section"
  aria-label="{{ section.settings.heading | escape }}"
>
  {%- if has_picker -%}
    <div class="av-hero__bg">
      {{
        section.settings.image
        | image_url: width: 2200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000, 2200',
          class: 'av-hero__bg-img'
      }}
    </div>
    <div class="av-hero__overlay" aria-hidden="true"></div>
  {%- elsif has_url != blank -%}
    <div class="av-hero__bg" role="img" aria-label="{{ section.settings.heading | escape }}"></div>
    <div class="av-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="av-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="av-hero__eyebrow av-reveal">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="av-hero__heading av-reveal" style="--av-delay: 90ms">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="av-hero__subheading av-reveal" style="--av-delay: 180ms">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="av-hero__cta av-reveal" style="--av-delay: 270ms" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label | escape }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AV Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (uploaded)"
    },
    {
      "type": "text",
      "id": "external_image_url",
      "label": "Background image URL",
      "info": "Used if no image is uploaded above. Paste a direct image URL."
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (desktop)",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 85,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (small text above heading)",
      "default": "New Season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Your Style"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the latest collection — curated just for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "AV Hero"
    }
  ]
}
{% endschema %}
