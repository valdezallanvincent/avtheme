{%- comment -%}
  AV HERO SECTION
  Full-bleed lifestyle hero. Background image with Ken Burns zoom.
  Editorial serif headline, staggered reveals, animated CTA.

  Priority: uploaded image → external URL → gradient fallback.
{%- endcomment -%}

{%- assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign has_picker = section.settings.image -%}
{%- assign has_url = section.settings.external_image_url | strip -%}
{%- assign align = section.settings.content_alignment -%}

{%- style -%}
  #av-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}px;
    display: flex;
    align-items: center;
    justify-content: {{ align }};
    overflow: hidden;
    /* Always keep a dark editorial base so the hero never flashes the page
       background while the image loads (or if it fails) — white text stays legible. */
    background: linear-gradient(160deg, #1a1208 0%, #2d1f0e 45%, #0d1a2e 100%);
  }

  #av-hero-{{ section.id }} .av-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: transform;
  }
  #av-hero-{{ section.id }} .av-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  {%- if has_url != blank and has_picker == blank -%}
  #av-hero-{{ section.id }} .av-hero__bg {
    background-image: url('{{ section.settings.external_image_url }}');
    background-size: cover;
    background-position: center;
    animation: av-hero-zoom 22s ease-in-out infinite alternate;
  }
  @keyframes av-hero-zoom {
    from { transform: scale(1);    background-position: center 60%; }
    to   { transform: scale(1.07); background-position: center 40%; }
  }
  {%- elsif has_picker -%}
  #av-hero-{{ section.id }} .av-hero__bg img {
    animation: av-hero-zoom-img 22s ease-in-out infinite alternate;
    transform-origin: center center;
  }
  @keyframes av-hero-zoom-img {
    from { transform: scale(1); }
    to   { transform: scale(1.07); }
  }
  {%- endif -%}

  /* Cinematic gradient overlay — heavy at bottom for text legibility */
  #av-hero-{{ section.id }} .av-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(0deg,
        rgba(0,0,0,{{ overlay_opacity }}) 0%,
        rgba(0,0,0,{{ overlay_opacity | times: 0.55 }}) 35%,
        rgba(0,0,0,{{ overlay_opacity | times: 0.15 }}) 70%,
        rgba(0,0,0,0) 100%
      ),
      linear-gradient(90deg, rgba(0,0,0,{{ overlay_opacity | times: 0.35 }}) 0%, rgba(0,0,0,0) 60%);
  }

  #av-hero-{{ section.id }} .av-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 8rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: {%- if align == 'center' -%}center{%- elsif align == 'flex-end' -%}flex-end{%- else -%}flex-start{%- endif -%};
    text-align: {%- if align == 'center' -%}center{%- elsif align == 'flex-end' -%}right{%- else -%}left{%- endif -%};
    color: #ffffff;
    gap: 0;
  }

  #av-hero-{{ section.id }} .av-hero__eyebrow {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--av-accent, rgba(255,255,255,0.7));
    margin-bottom: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
  }
  #av-hero-{{ section.id }} .av-hero__eyebrow::before,
  #av-hero-{{ section.id }} .av-hero__eyebrow::after {
    content: '';
    display: inline-block;
    width: 2.8rem;
    height: 1px;
    background: var(--av-accent, rgba(255,255,255,0.5));
  }

  #av-hero-{{ section.id }} .av-hero__heading {
    font-family: var(--av-font-heading, Georgia, serif) !important;
    font-size: clamp(4.4rem, 8.5vw, 10rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 2.4rem;
    max-width: 80rem;
    color: #ffffff !important;
    text-shadow: 0 4px 40px rgba(0,0,0,0.3);
  }
  /* Italic second line effect */
  #av-hero-{{ section.id }} .av-hero__heading em {
    font-style: italic;
    font-weight: 400;
  }

  #av-hero-{{ section.id }} .av-hero__subheading {
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    font-weight: 300;
    line-height: 1.7;
    max-width: 52rem;
    opacity: 0.88;
    margin: 0 0 4rem;
    {%- if align != 'center' and align != 'flex-end' -%}
    margin-left: 0;
    {%- else -%}
    margin-left: auto;
    margin-right: auto;
    {%- endif -%}
  }

  #av-hero-{{ section.id }} .av-hero__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    {%- if align == 'center' -%}justify-content: center;{%- endif -%}
  }

  #av-hero-{{ section.id }} .av-hero__cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1.6rem 4rem;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--av-radius-pill, 100px);
    background: #ffffff;
    color: #0d0d0d;
    border: 2px solid #ffffff;
    transition: background var(--av-transition, 0.35s ease),
                color var(--av-transition),
                transform 0.25s ease,
                box-shadow 0.25s ease;
    box-shadow: 0 8px 32px rgba(0,0,0,0.22);
  }
  #av-hero-{{ section.id }} .av-hero__cta-primary:hover {
    background: transparent;
    color: #ffffff;
    transform: translateY(-3px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.32);
  }
  #av-hero-{{ section.id }} .av-hero__cta-primary svg { transition: transform 0.25s ease; }
  #av-hero-{{ section.id }} .av-hero__cta-primary:hover svg { transform: translateX(5px); }

  #av-hero-{{ section.id }} .av-hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    border-bottom: 1px solid rgba(255,255,255,0.4);
    padding-bottom: 2px;
    transition: color 0.2s, border-color 0.2s;
  }
  #av-hero-{{ section.id }} .av-hero__cta-secondary:hover {
    color: #ffffff;
    border-color: #ffffff;
  }

  /* Scroll indicator */
  #av-hero-{{ section.id }} .av-hero__scroll {
    position: absolute;
    bottom: 3.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    color: rgba(255,255,255,0.5);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: av-hero-scroll-bounce 2s ease-in-out infinite;
  }
  #av-hero-{{ section.id }} .av-hero__scroll-line {
    width: 1px;
    height: 4rem;
    background: linear-gradient(to bottom, rgba(255,255,255,0.5), rgba(255,255,255,0));
  }
  @keyframes av-hero-scroll-bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  @media screen and (max-width: 749px) {
    #av-hero-{{ section.id }} {
      min-height: {{ section.settings.section_height | times: 0.75 | round }}px;
    }
    #av-hero-{{ section.id }} .av-hero__content {
      padding: 6rem 2rem;
    }
    #av-hero-{{ section.id }} .av-hero__scroll { display: none; }
  }
{%- endstyle -%}

<section
  id="av-hero-{{ section.id }}"
  class="av-hero-section"
  aria-label="{{ section.settings.heading | strip_html | escape }}"
>
  {%- if has_picker -%}
    <div class="av-hero__bg">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800,1200,1600,2000,2400',
          alt: section.settings.heading | escape
      }}
    </div>
  {%- elsif has_url != blank -%}
    <div class="av-hero__bg" role="img" aria-label="{{ section.settings.heading | escape }}"></div>
  {%- endif -%}
  <div class="av-hero__overlay" aria-hidden="true"></div>

  <div class="av-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="av-hero__eyebrow av-reveal">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="av-hero__heading av-reveal" style="--av-delay: 80ms">
        {{- section.settings.heading | newline_to_br -}}
      </h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="av-hero__subheading av-reveal" style="--av-delay: 200ms">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="av-hero__actions av-reveal" style="--av-delay: 320ms">
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="av-hero__cta-primary" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank -%}
        <a class="av-hero__cta-secondary" href="{{ section.settings.secondary_button_link }}">
          {{ section.settings.secondary_button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <div class="av-hero__scroll" aria-hidden="true">
      <div class="av-hero__scroll-line"></div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "AV Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (uploaded)"
    },
    {
      "type": "text",
      "id": "external_image_url",
      "label": "Background image URL",
      "info": "Used if no image uploaded. Paste a direct image URL."
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (desktop)",
      "min": 400, "max": 1000, "step": 50, "unit": "px",
      "default": 750
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 0, "max": 90, "step": 5, "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "flex-start"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (small text above)",
      "default": "New Season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Dress the Life You Want"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Timeless essentials, thoughtfully made and curated just for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    { "name": "AV Hero" }
  ]
}
{% endschema %}
