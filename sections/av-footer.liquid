{%- comment -%}
  AV FOOTER — full dark lifestyle footer
  Brand column · Nav links · Newsletter · Social · Legal
{%- endcomment -%}

{%- style -%}
  .av-footer {
    background: #0d0d0d;
    color: rgba(249,247,244,0.75);
    padding: 8rem 0 0;
    font-family: var(--av-font-body, sans-serif);
  }
  .av-footer__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 5.6rem;
  }

  /* Brand column */
  .av-footer__brand-name {
    font-family: var(--av-font-heading, Georgia, serif);
    font-size: 3.2rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #f9f7f4;
    margin: 0 0 1.6rem;
    line-height: 1;
  }
  .av-footer__tagline {
    font-size: 1.4rem;
    line-height: 1.7;
    color: rgba(249,247,244,0.5);
    margin: 0 0 3.2rem;
    max-width: 28rem;
  }
  .av-footer__social {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .av-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    border: 1px solid rgba(249,247,244,0.15);
    color: rgba(249,247,244,0.6);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .av-footer__social-link:hover {
    border-color: var(--av-accent, #c9a96e);
    color: var(--av-accent, #c9a96e);
    background: rgba(201,169,110,0.08);
  }
  .av-footer__social-link svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }

  /* Nav columns */
  .av-footer__col-heading {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f9f7f4;
    margin: 0 0 2.4rem;
  }
  .av-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .av-footer__links a {
    font-size: 1.4rem;
    color: rgba(249,247,244,0.5);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }
  .av-footer__links a:hover { color: #f9f7f4; }

  /* Newsletter column */
  .av-footer__nl-text {
    font-size: 1.4rem;
    line-height: 1.7;
    color: rgba(249,247,244,0.5);
    margin: 0 0 2.4rem;
  }
  .av-footer__nl-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .av-footer__nl-input {
    padding: 1.3rem 1.6rem;
    font-size: 1.4rem;
    font-family: var(--av-font-body, sans-serif);
    background: rgba(249,247,244,0.06);
    border: 1px solid rgba(249,247,244,0.15);
    border-radius: 4px;
    color: #f9f7f4;
    outline: none;
    transition: border-color 0.2s ease;
    width: 100%;
  }
  .av-footer__nl-input::placeholder { color: rgba(249,247,244,0.3); }
  .av-footer__nl-input:focus { border-color: var(--av-accent, #c9a96e); }
  .av-footer__nl-btn {
    padding: 1.3rem 2.4rem;
    font-size: 1.3rem;
    font-weight: 600;
    font-family: var(--av-font-body, sans-serif);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--av-accent, #c9a96e);
    color: #0d0d0d;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
    width: 100%;
  }
  .av-footer__nl-btn:hover { opacity: 0.88; transform: translateY(-1px); }

  /* Divider */
  .av-footer__divider {
    max-width: var(--page-width);
    margin: 6.4rem auto 0;
    padding: 0 2rem;
    border-top: 1px solid rgba(249,247,244,0.08);
  }
  .av-footer__bottom {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 2.4rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .av-footer__copyright {
    font-size: 1.25rem;
    color: rgba(249,247,244,0.3);
  }
  .av-footer__legal {
    display: flex;
    gap: 2.4rem;
    flex-wrap: wrap;
  }
  .av-footer__legal a {
    font-size: 1.25rem;
    color: rgba(249,247,244,0.3);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .av-footer__legal a:hover { color: rgba(249,247,244,0.7); }
  .av-footer__accent-line {
    display: block;
    width: 3.2rem;
    height: 2px;
    background: var(--av-accent, #c9a96e);
    margin-bottom: 2.8rem;
  }

  @media (max-width: 989px) {
    .av-footer__inner { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  @media (max-width: 580px) {
    .av-footer__inner { grid-template-columns: 1fr; gap: 3.6rem; }
    .av-footer__bottom { flex-direction: column; align-items: flex-start; }
  }
{%- endstyle -%}

<footer class="av-footer" role="contentinfo">
  <div class="av-footer__inner">

    {%- comment -%} Brand column {%- endcomment -%}
    <div class="av-footer__brand av-reveal">
      <p class="av-footer__brand-name">{{ shop.name }}</p>
      <span class="av-footer__accent-line"></span>
      <p class="av-footer__tagline">Quality you can feel, at prices that make sense. Curated pieces for the life you want to live.</p>
      <div class="av-footer__social">
        {%- if settings.social_instagram_link != blank -%}
          <a class="av-footer__social-link" href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener">
