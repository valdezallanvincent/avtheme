{%- comment -%}
  AV COLLECTION TILES
  Editorial image tiles linking to collections — the hallmark of any lifestyle store.
  Supports 2-col, 3-col, or asymmetric (large-left + 2 stacked right) layouts.
{%- endcomment -%}

{%- style -%}
  #av-ct-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: rgb(var(--color-background));
  }
  #av-ct-{{ section.id }} .av-ct__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }
  #av-ct-{{ section.id }} .av-ct__header {
    text-align: center;
    margin-bottom: 4.4rem;
  }
  #av-ct-{{ section.id }} .av-ct__eyebrow {
    display: inline-block;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--av-accent, rgba(var(--color-foreground),0.45));
    margin-bottom: 0.8rem;
  }
  #av-ct-{{ section.id }} .av-ct__heading {
    font-size: clamp(2.8rem, 4vw, 5rem);
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin: 0;
    font-family: var(--av-font-heading, serif);
  }

  /* Grid layouts */
  #av-ct-{{ section.id }} .av-ct__grid {
    gap: 1.6rem;
  }
  #av-ct-{{ section.id }} .av-ct__grid--2col { display: grid; grid-template-columns: repeat(2,1fr); }
  #av-ct-{{ section.id }} .av-ct__grid--3col { display: grid; grid-template-columns: repeat(3,1fr); }
  #av-ct-{{ section.id }} .av-ct__grid--asymmetric {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  #av-ct-{{ section.id }} .av-ct__grid--asymmetric .av-ct__tile:first-child {
    grid-row: 1 / 3;
  }

  /* Tile */
  #av-ct-{{ section.id }} .av-ct__tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--av-radius-card, 4px);
    display: block;
    text-decoration: none;
    background: rgba(var(--color-foreground),0.06);
  }
  #av-ct-{{ section.id }} .av-ct__tile-img-wrap {
    position: relative;
    width: 100%;
    padding-bottom: {{ section.settings.tile_ratio }}%;
    overflow: hidden;
  }
  #av-ct-{{ section.id }} .av-ct__grid--asymmetric .av-ct__tile:first-child .av-ct__tile-img-wrap {
    padding-bottom: 0;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  #av-ct-{{ section.id }} .av-ct__grid--asymmetric .av-ct__tile:first-child {
    min-height: 52rem;
  }
  #av-ct-{{ section.id }} .av-ct__tile-img-wrap img,
  #av-ct-{{ section.id }} .av-ct__tile-img-wrap .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--av-transition, 0.35s ease);
  }
  #av-ct-{{ section.id }} .av-ct__tile:hover .av-ct__tile-img-wrap img {
    transform: scale(1.06);
  }
  #av-ct-{{ section.id }} .av-ct__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.65) 0%,
      rgba(0,0,0,0.1) 55%,
      rgba(0,0,0,0) 100%
    );
    transition: opacity 0.35s ease;
    z-index: 1;
  }
  #av-ct-{{ section.id }} .av-ct__tile:hover .av-ct__overlay {
    opacity: 0.85;
  }
  #av-ct-{{ section.id }} .av-ct__tile-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.8rem 3rem;
    color: #fff;
  }
  #av-ct-{{ section.id }} .av-ct__tile-label {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 0.5rem;
  }
  #av-ct-{{ section.id }} .av-ct__tile-title {
    font-size: clamp(2rem, 3vw, 3.2rem);
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 1.4rem;
    font-family: var(--av-font-heading, serif);
  }
  #av-ct-{{ section.id }} .av-ct__tile-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  #av-ct-{{ section.id }} .av-ct__tile:hover .av-ct__tile-cta {
    opacity: 1;
    transform: translateY(0);
  }
  #av-ct-{{ section.id }} .av-ct__tile-cta svg { width: 1.4rem; height: 1.4rem; }

  @media (max-width: 749px) {
    #av-ct-{{ section.id }} .av-ct__grid--2col,
    #av-ct-{{ section.id }} .av-ct__grid--3col,
    #av-ct-{{ section.id }} .av-ct__grid--asymmetric {
      grid-template-columns: 1fr;
    }
    #av-ct-{{ section.id }} .av-ct__grid--asymmetric .av-ct__tile:first-child {
      grid-row: auto;
      min-height: 0;
    }
    #av-ct-{{ section.id }} .av-ct__grid--asymmetric .av-ct__tile:first-child .av-ct__tile-img-wrap {
      position: relative;
      inset: auto;
      height: auto;
      padding-bottom: {{ section.settings.tile_ratio }}%;
    }
  }
{%- endstyle -%}

{%- assign layout_class = 'av-ct__grid--' | append: section.settings.layout -%}

<section id="av-ct-{{ section.id }}" class="av-collection-tiles-section">
  <div class="av-ct__inner">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="av-ct__header av-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="av-ct__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="av-ct__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="av-ct__grid {{ layout_class }}">
      {%- for block in section.blocks -%}
        {%- assign tile_url = block.settings.link | default: collections.all.url -%}
        <a class="av-ct__tile av-reveal" style="--av-delay: {{ forloop.index0 | times: 100 }}ms" href="{{ tile_url }}" {{ block.shopify_attributes }}>
          <div class="av-ct__tile-img-wrap">
            {%- if block.settings.image -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  widths: '400,600,800,1000,1200',
                  alt: block.settings.title | escape
              }}
            {%- elsif block.settings.image_url != blank -%}
              <img src="{{ block.settings.image_url }}?auto=format&fit=crop&w=1000&q=85" alt="{{ block.settings.title | escape }}" width="1000" height="750" loading="lazy">
            {%- else -%}
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="av-ct__overlay"></div>
          <div class="av-ct__tile-content">
            {%- if block.settings.label != blank -%}
              <p class="av-ct__tile-label">{{ block.settings.label | escape }}</p>
            {%- endif -%}
            <h3 class="av-ct__tile-title">{{ block.settings.title | escape }}</h3>
            <span class="av-ct__tile-cta">
              {{ block.settings.cta | default: 'Shop Now' | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AV Collection Tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (uploaded)"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL (if no upload)",
          "info": "Paste an Unsplash URL."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label (small text)",
          "default": "New Season"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Women's Edit"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Browse the edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Shop by Category"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "2col", "label": "2 columns" },
        { "value": "3col", "label": "3 columns" },
        { "value": "asymmetric", "label": "Asymmetric (hero left)" }
      ],
      "default": "asymmetric"
    },
    {
      "type": "range",
      "id": "tile_ratio",
      "label": "Tile image ratio (height %)",
      "min": 50, "max": 140, "step": 5,
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "AV Collection Tiles",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=1000&q=80",
            "label": "New Season",
            "title": "Women's Edit",
            "cta": "Shop Now",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&w=1000&q=80",
            "label": "Essentials",
            "title": "Men's Collection",
            "cta": "Explore",
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1558769132-cb1aea458c5e?auto=format&fit=crop&w=1000&q=80",
            "label": "Curated",
            "title": "Accessories",
            "cta": "Shop Now",
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
