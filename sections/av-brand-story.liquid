{%- comment -%}
  ============================================================
  AV BRAND STORY SECTION
  Two-column layout: image on the left, text on the right.
  Stacks vertically on mobile. Editable in theme customizer.

  Skills: image_url filter, lazy loading, flexbox layout,
  responsive design, optional button, color scheme support.
  ============================================================
{%- endcomment -%}

{%- style -%}
  #av-bs-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: rgb(var(--color-background));
  }

  /* Swap image/text order if layout is 'image_right' */
  #av-bs-{{ section.id }} .av-bs__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 6rem;
    flex-direction: {% if section.settings.layout == 'image_right' %}row-reverse{% else %}row{% endif %};
  }

  #av-bs-{{ section.id }} .av-bs__image-col {
    flex: 1 1 45%;
    min-width: 0;
  }

  #av-bs-{{ section.id }} .av-bs__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
    aspect-ratio: {{ section.settings.image_ratio }};
    background-color: rgba(var(--color-foreground), 0.04);
  }

  #av-bs-{{ section.id }} .av-bs__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #av-bs-{{ section.id }} .av-bs__text-col {
    flex: 1 1 50%;
    min-width: 0;
  }

  #av-bs-{{ section.id }} .av-bs__label {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.5);
    margin-bottom: 1.2rem;
  }

  #av-bs-{{ section.id }} .av-bs__heading {
    font-size: clamp(2.8rem, 4vw, 4.8rem);
    font-weight: 700;
    line-height: 1.15;
    color: rgb(var(--color-foreground));
    margin: 0 0 2rem;
  }

  #av-bs-{{ section.id }} .av-bs__body {
    font-size: 1.6rem;
    line-height: 1.8;
    color: rgba(var(--color-foreground), 0.75);
    margin: 0 0 3rem;
  }

  #av-bs-{{ section.id }} .av-bs__cta {
    display: inline-flex;
    align-items: center;
    padding: 1.2rem 2.8rem;
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--buttons-radius, 0);
    transition: opacity 0.2s ease, transform 0.2s ease;
    background-color: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
  }

  #av-bs-{{ section.id }} .av-bs__cta:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  /* Stack on mobile */
  @media screen and (max-width: 749px) {
    #av-bs-{{ section.id }} .av-bs__inner {
      flex-direction: column;
      gap: 3.2rem;
    }
    #av-bs-{{ section.id }} .av-bs__image-col,
    #av-bs-{{ section.id }} .av-bs__text-col {
      flex: none;
      width: 100%;
    }
  }
{%- endstyle -%}

{%- assign bs_has_url = section.settings.external_image_url | strip -%}
<section id="av-bs-{{ section.id }}" class="av-brand-story-section">
  <div class="av-bs__inner">

    {%- comment -%} Image column {%- endcomment -%}
    <div class="av-bs__image-col av-reveal av-reveal--zoom">
      <div class="av-bs__image-wrap">
        {%- if section.settings.image -%}
          {{
            section.settings.image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              width: section.settings.image.width,
              height: section.settings.image.height,
              sizes: '(min-width: 750px) 45vw, 100vw',
              widths: '400, 600, 800, 1000',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        {%- elsif bs_has_url != blank -%}
          <img
            src="{{ section.settings.external_image_url }}?auto=format&fit=crop&w=1000&q=80"
            alt="{{ section.settings.heading | escape }}"
            width="1000"
            height="750"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Text column {%- endcomment -%}
    <div class="av-bs__text-col">
      {%- if section.settings.label != blank -%}
        <span class="av-bs__label av-reveal">{{ section.settings.label | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="av-bs__heading av-reveal" style="--av-delay: 80ms">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="av-bs__body av-reveal" style="--av-delay: 160ms">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="av-bs__cta av-reveal" style="--av-delay: 240ms" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "AV Brand Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image_left", "label": "Image left" },
        { "value": "image_right", "label": "Image right" }
      ],
      "default": "image_left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (uploaded)"
    },
    {
      "type": "text",
      "id": "external_image_url",
      "label": "Image URL",
      "info": "Used if no image is uploaded above."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "3 / 4", "label": "Portrait (3:4)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label (small text above heading)",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted with care, built to last."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>We believe great products come from great intentions. Every item in our store is thoughtfully sourced, rigorously tested, and made to bring real value to your everyday life.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "AV Brand Story"
    }
  ]
}
{% endschema %}
