{% comment %}
  ============================================================
  CUSTOM TESTIMONIALS SECTION
  A fully customizable testimonials/reviews section.

  Skills demonstrated (JD):
  - Liquid: for loops, if/else, filters, schema settings
  - HTML5 semantic markup
  - CSS3 custom properties, flexbox, responsive design
  - Custom section development from scratch
  ============================================================
{% endcomment %}

{%- style -%}
  .testimonials-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: rgb(var(--color-background));
  }

  .testimonials-section .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .testimonials-section .section-header h2 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin-bottom: 1rem;
    color: rgb(var(--color-foreground));
  }

  .testimonials-section .section-header p {
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.65);
    max-width: 60rem;
    margin: 0 auto;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 2.4rem;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .testimonial-card {
    background: rgb(var(--color-background));
    border: 0.1rem solid rgba(var(--color-foreground), 0.08);
    border-radius: {{ section.settings.card_radius }}px;
    padding: 3.2rem 2.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    box-shadow: 0 2px 16px rgba(var(--color-shadow), 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(var(--color-shadow), 0.12);
  }

  .testimonial-stars {
    display: flex;
    gap: 0.4rem;
    color: #f5a623;
    font-size: 1.8rem;
  }

  .testimonial-quote {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.8);
    flex: 1;
    font-style: italic;
  }

  .testimonial-quote::before {
    content: '\201C';
    font-size: 3rem;
    line-height: 0;
    vertical-align: -1rem;
    margin-right: 0.4rem;
    color: rgba(var(--color-foreground), 0.2);
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 0.8rem;
  }

  .testimonial-author__avatar {
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(var(--color-foreground), 0.08);
    flex-shrink: 0;
  }

  .testimonial-author__avatar-placeholder {
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: rgba(var(--color-foreground), 0.4);
    flex-shrink: 0;
  }

  .testimonial-author__info strong {
    display: block;
    font-size: 1.5rem;
    color: rgb(var(--color-foreground));
  }

  .testimonial-author__info span {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.55);
  }

  @media screen and (max-width: 989px) {
    .testimonials-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
    .testimonial-card {
      padding: 2.4rem 2rem;
    }
  }
{%- endstyle -%}

<section class="testimonials-section color-{{ section.settings.color_scheme }}" id="Testimonials-{{ section.id }}">
  <div class="section-header">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p>{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <div class="testimonials-grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'testimonial' -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>

          {%- comment -%} Star rating {%- endcomment -%}
          {%- if block.settings.show_stars -%}
            <div class="testimonial-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- assign rating = block.settings.rating -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} Quote text {%- endcomment -%}
          {%- if block.settings.quote != blank -%}
            <p class="testimonial-quote">{{ block.settings.quote }}</p>
          {%- endif -%}

          {%- comment -%} Author info {%- endcomment -%}
          <div class="testimonial-author">
            {%- if block.settings.author_image != blank -%}
              <img
                class="testimonial-author__avatar"
                src="{{ block.settings.author_image | image_url: width: 96 }}"
                alt="{{ block.settings.author_name | escape }}"
                width="48"
                height="48"
                loading="lazy"
              >
            {%- else -%}
              <div class="testimonial-author__avatar-placeholder" aria-hidden="true">
                {{ block.settings.author_name | slice: 0 | upcase }}
              </div>
            {%- endif -%}

            <div class="testimonial-author__info">
              {%- if block.settings.author_name != blank -%}
                <strong>{{ block.settings.author_name }}</strong>
              {%- endif -%}
              {%- if block.settings.author_title != blank -%}
                <span>{{ block.settings.author_title }}</span>
              {%- endif -%}
            </div>
          </div>

        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews from real customers"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on tablet",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "show_stars",
          "label": "Show stars",
          "default": true
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This product completely changed my routine. Absolutely love the quality and fast shipping!"
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author photo"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Jane D."
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Author title / location",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "author_name": "Maria Santos",
            "author_title": "Verified buyer",
            "quote": "Absolutely love the quality! Will definitely order again.",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author_name": "John Reyes",
            "author_title": "Verified buyer",
            "quote": "Fast shipping and the product exceeded my expectations. Highly recommend!",
            "rating": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author_name": "Anna Cruz",
            "author_title": "Verified buyer",
            "quote": "Great customer service and amazing product. 10/10.",
            "rating": 4
          }
        }
      ]
    }
  ]
}
{% endschema %}
