{%- comment -%}
  CUSTOM TESTIMONIALS — card grid with avatars, stars, verified badges
{%- endcomment -%}

{%- style -%}
  #av-tm-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: rgba(var(--color-foreground), 0.03);
  }
  #av-tm-{{ section.id }} .av-tm__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }
  #av-tm-{{ section.id }} .av-tm__header {
    text-align: center;
    margin-bottom: 5.2rem;
  }
  #av-tm-{{ section.id }} .av-tm__eyebrow {
    display: inline-block;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.45);
    margin-bottom: 1rem;
  }
  #av-tm-{{ section.id }} .av-tm__heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin: 0;
  }
  #av-tm-{{ section.id }} .av-tm__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem;
  }
  #av-tm-{{ section.id }} .av-tm__card {
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: 16px;
    padding: 3.2rem 2.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  #av-tm-{{ section.id }} .av-tm__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(0,0,0,0.1);
  }
  #av-tm-{{ section.id }} .av-tm__stars {
    display: flex;
    gap: 0.3rem;
  }
  #av-tm-{{ section.id }} .av-tm__star {
    width: 1.8rem;
    height: 1.8rem;
    fill: #f59e0b;
    color: #f59e0b;
  }
  #av-tm-{{ section.id }} .av-tm__quote {
    font-size: 1.55rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.8);
    margin: 0;
    flex: 1;
    position: relative;
    padding-left: 1.2rem;
  }
  #av-tm-{{ section.id }} .av-tm__quote::before {
    content: '\201C';
    font-size: 5rem;
    line-height: 0.5;
    color: rgba(var(--color-foreground), 0.1);
    position: absolute;
    top: -0.6rem;
    left: -0.8rem;
    font-family: Georgia, serif;
  }
  #av-tm-{{ section.id }} .av-tm__author {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.07);
  }
  #av-tm-{{ section.id }} .av-tm__avatar {
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  #av-tm-{{ section.id }} .av-tm__avatar-initial {
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(var(--color-foreground), 0.14), rgba(var(--color-foreground), 0.06));
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: rgba(var(--color-foreground), 0.5);
    flex-shrink: 0;
  }
  #av-tm-{{ section.id }} .av-tm__name {
    font-size: 1.4rem;
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin: 0 0 0.2rem;
  }
  #av-tm-{{ section.id }} .av-tm__meta {
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.5);
    margin: 0;
  }
  #av-tm-{{ section.id }} .av-tm__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1.1rem;
    color: #16a34a;
    font-weight: 600;
    margin-left: auto;
    white-space: nowrap;
  }
  @media (max-width: 989px) {
    #av-tm-{{ section.id }} .av-tm__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 580px) {
    #av-tm-{{ section.id }} .av-tm__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

{%- assign star_svg = '<svg class="av-tm__star" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>' -%}

<section id="av-tm-{{ section.id }}" class="custom-testimonials-section">
  <div class="av-tm__inner">
    <div class="av-tm__header av-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="av-tm__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="av-tm__heading">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="av-tm__grid">
      {%- for block in section.blocks -%}
        {%- assign stars = block.settings.rating | default: 5 -%}
        <div class="av-tm__card av-reveal" style="--av-delay: {{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
          <div class="av-tm__stars">
            {%- for i in (1..stars) -%}{{ star_svg }}{%- endfor -%}
          </div>
          <p class="av-tm__quote">{{ block.settings.quote | escape }}</p>
          <div class="av-tm__author">
            {%- if block.settings.avatar_url != blank -%}
              <img class="av-tm__avatar" src="{{ block.settings.avatar_url }}" alt="{{ block.settings.name | escape }}" width="44" height="44" loading="lazy">
            {%- else -%}
              <div class="av-tm__avatar-initial" aria-hidden="true">{{ block.settings.name | slice: 0 | upcase }}</div>
            {%- endif -%}
            <div>
              <p class="av-tm__name">{{ block.settings.name | escape }}</p>
              {%- if block.settings.meta != blank -%}
                <p class="av-tm__meta">{{ block.settings.meta | escape }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.verified -%}
              <span class="av-tm__verified">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                Verified
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "max_blocks": 9,
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1, "max": 5, "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "default": "Absolutely love the quality! Will definitely order again."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Maria Santos"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta (e.g. Verified Buyer · Metro Manila)",
          "default": "Metro Manila"
        },
        {
          "type": "text",
          "id": "avatar_url",
          "label": "Avatar image URL (optional)"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified badge",
          "default": true
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What customers say"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by thousands"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "I've been shopping here for months and the quality never disappoints. The fabrics are soft, the fit is perfect, and delivery was super fast!",
            "name": "Maria Santos",
            "meta": "Verified Buyer · Metro Manila",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "Finally found a brand that gets it right. The packaging was beautiful and the product exceeded my expectations. 10/10 would recommend!",
            "name": "Jake Reyes",
            "meta": "Verified Buyer · Cebu City",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "Great pieces, great price. I ordered two sizes and the return process was so easy. Definitely a repeat customer.",
            "name": "Ana Cruz",
            "meta": "Verified Buyer · Davao",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
