{%- comment -%}
  AV FEATURES BAR
  Icon + label + description trust-signal strip.
  Sits just below the hero. Fully editable in customizer.
{%- endcomment -%}

{%- style -%}
  #av-fb-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: rgb(var(--color-background));
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.08);
  }
  #av-fb-{{ section.id }} .av-fb__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    gap: 2.4rem;
  }
  #av-fb-{{ section.id }} .av-fb__item {
    display: flex;
    align-items: flex-start;
    gap: 1.6rem;
  }
  #av-fb-{{ section.id }} .av-fb__icon {
    flex-shrink: 0;
    width: 4.8rem;
    height: 4.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.06);
    color: rgb(var(--color-foreground));
  }
  #av-fb-{{ section.id }} .av-fb__icon svg {
    width: 2.2rem;
    height: 2.2rem;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #av-fb-{{ section.id }} .av-fb__text { flex: 1; }
  #av-fb-{{ section.id }} .av-fb__label {
    font-size: 1.4rem;
    font-weight: 700;
    color: rgb(var(--color-foreground));
    margin: 0 0 0.3rem;
  }
  #av-fb-{{ section.id }} .av-fb__desc {
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0;
    line-height: 1.5;
  }
  @media (max-width: 749px) {
    #av-fb-{{ section.id }} .av-fb__inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 480px) {
    #av-fb-{{ section.id }} .av-fb__inner {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

{%- assign svg_shipping = '<path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a1 1 0 0 1 1 1v3m0 0h3l3 3v4h-3m-3 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0M9 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/>' -%}
{%- assign svg_return = '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' -%}
{%- assign svg_secure = '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>' -%}
{%- assign svg_star = '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>' -%}
{%- assign svg_gift = '<polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>' -%}
{%- assign svg_support = '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.36 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.11 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16z"/>' -%}

{%- assign svgs = svg_shipping | append: '||' | append: svg_return | append: '||' | append: svg_secure | append: '||' | append: svg_star | append: '||' | append: svg_gift | append: '||' | append: svg_support | split: '||' -%}

<section id="av-fb-{{ section.id }}" class="av-features-bar-section">
  <div class="av-fb__inner">
    {%- for block in section.blocks -%}
      {%- assign icon_index = block.settings.icon | minus: 1 -%}
      <div class="av-fb__item av-reveal" style="--av-delay: {{ forloop.index0 | times: 60 }}ms" {{ block.shopify_attributes }}>
        <div class="av-fb__icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">{{ svgs[icon_index] }}</svg>
        </div>
        <div class="av-fb__text">
          <p class="av-fb__label">{{ block.settings.label | escape }}</p>
          {%- if block.settings.description != blank -%}
            <p class="av-fb__desc">{{ block.settings.description | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "AV Features Bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "feature",
      "name": "Feature item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "1", "label": "Shipping truck" },
            { "value": "2", "label": "Returns / home" },
            { "value": "3", "label": "Secure lock" },
            { "value": "4", "label": "Quality star" },
            { "value": "5", "label": "Gift" },
            { "value": "6", "label": "Support / phone" }
          ],
          "default": "1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On orders over ₱1,500"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 80, "step": 4, "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "AV Features Bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "1", "label": "Free Shipping", "description": "On orders over ₱1,500" } },
        { "type": "feature", "settings": { "icon": "3", "label": "Secure Checkout", "description": "100% encrypted payments" } },
        { "type": "feature", "settings": { "icon": "2", "label": "Easy Returns", "description": "30-day hassle-free returns" } },
        { "type": "feature", "settings": { "icon": "4", "label": "Premium Quality", "description": "Curated for lasting wear" } }
      ]
    }
  ]
}
{% endschema %}
