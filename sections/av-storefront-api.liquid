{%- comment -%}
  ============================================================
  AV STOREFRONT API SECTION
  Loads products client-side using the Shopify Storefront API
  (GraphQL) via fetch(). Demonstrates the JD skill:
  "Shopify Storefront API usage with fetch()".

  How it works:
  - The Storefront API is a public, token-authenticated GraphQL
    endpoint at /api/{version}/graphql.json.
  - We POST a GraphQL query with the
    'X-Shopify-Storefront-Access-Token' header.
  - Results are rendered into a grid entirely on the client.

  SETUP (one time, ~1 min):
  1. Shopify Admin → Settings → Apps and sales channels →
     Develop apps → Create an app.
  2. Configuration → Storefront API → enable
     'unauthenticated_read_product_listings'.
  3. Install app → API credentials → copy the
     "Storefront API access token".
  4. Paste it into this section's "Storefront API token"
     setting in the theme customizer.

  Note: the Storefront token is a PUBLIC token (safe to expose
  client-side) — it only grants read access to published data.
  ============================================================
{%- endcomment -%}

<section
  id="av-sfapi-{{ section.id }}"
  class="av-sfapi"
  data-token="{{ section.settings.storefront_api_token }}"
  data-api-version="{{ section.settings.api_version }}"
  data-count="{{ section.settings.products_to_show }}"
  data-shop="{{ shop.permanent_domain }}"
>
  <div class="av-sfapi__inner page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="av-sfapi__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- comment -%} Status / loading region — replaced by JS {%- endcomment -%}
    <div class="av-sfapi__status" id="av-sfapi-status-{{ section.id }}">
      {%- if section.settings.storefront_api_token == blank -%}
        Add a Storefront API token in the theme settings to load products here.
      {%- else -%}
        Loading products from the Storefront API…
      {%- endif -%}
    </div>

    {%- comment -%} Products render into this grid {%- endcomment -%}
    <div class="av-sfapi__grid" id="av-sfapi-grid-{{ section.id }}" hidden></div>
  </div>
</section>

<style>
  #av-sfapi-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: rgb(var(--color-background));
  }
  #av-sfapi-{{ section.id }} .av-sfapi__heading {
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight: 700;
    text-align: center;
    margin: 0 0 3rem;
    color: rgb(var(--color-foreground));
  }
  #av-sfapi-{{ section.id }} .av-sfapi__status {
    text-align: center;
    font-size: 1.5rem;
    color: rgba(var(--color-foreground), 0.6);
  }
  #av-sfapi-{{ section.id }} .av-sfapi__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.4rem;
  }
  #av-sfapi-{{ section.id }} .av-sfapi__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  #av-sfapi-{{ section.id }} .av-sfapi__card img,
  #av-sfapi-{{ section.id }} .av-sfapi__card .ph {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--card-corner-radius, 0);
    background: rgba(var(--color-foreground), 0.06);
    display: block;
  }
  #av-sfapi-{{ section.id }} .av-sfapi__card-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 1.2rem 0 0.4rem;
    color: rgb(var(--color-foreground));
  }
  #av-sfapi-{{ section.id }} .av-sfapi__card-price {
    font-size: 1.5rem;
    color: rgba(var(--color-foreground), 0.8);
  }
  @media screen and (max-width: 989px) {
    #av-sfapi-{{ section.id }} .av-sfapi__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
(function () {
  'use strict';

  const root = document.getElementById('av-sfapi-{{ section.id }}');
  if (!root) return;

  const token      = root.dataset.token;
  const apiVersion = root.dataset.apiVersion || '2024-10';
  const count      = parseInt(root.dataset.count, 10) || 4;
  const shop       = root.dataset.shop;
  const statusEl   = document.getElementById('av-sfapi-status-{{ section.id }}');
  const gridEl     = document.getElementById('av-sfapi-grid-{{ section.id }}');

  // No token configured yet — leave the setup message in place.
  if (!token) return;

  // GraphQL query: fetch the first N published products with their
  // first image and price range.
  const query = `
    query getProducts($count: Int!) {
      products(first: $count) {
        edges {
          node {
            id
            title
            handle
            featuredImage { url altText }
            priceRange {
              minVariantPrice { amount currencyCode }
            }
          }
        }
      }
    }`;

  // Format a money amount using the browser's Intl API.
  function money(amount, currency) {
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: currency || 'USD',
      }).format(parseFloat(amount));
    } catch (e) {
      return amount + ' ' + (currency || '');
    }
  }

  // POST the GraphQL query to the Storefront API endpoint.
  fetch(`https://${shop}/api/${apiVersion}/graphql.json`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Shopify-Storefront-Access-Token': token,
    },
    body: JSON.stringify({ query, variables: { count } }),
  })
    .then((res) => {
      if (!res.ok) throw new Error('Storefront API returned ' + res.status);
      return res.json();
    })
    .then((payload) => {
      if (payload.errors) {
        throw new Error(payload.errors.map((e) => e.message).join('; '));
      }

      const edges = (payload.data &&
        payload.data.products &&
        payload.data.products.edges) || [];

      if (!edges.length) {
        statusEl.textContent = 'No products returned by the Storefront API.';
        return;
      }

      // Build the cards.
      gridEl.innerHTML = edges
        .map(({ node }) => {
          const price = node.priceRange.minVariantPrice;
          const img = node.featuredImage
            ? `<img src="${node.featuredImage.url}" alt="${(node.featuredImage.altText || node.title).replace(/"/g, '&quot;')}" width="400" height="400" loading="lazy">`
            : `<span class="ph" aria-hidden="true"></span>`;
          return `
            <a class="av-sfapi__card" href="/products/${node.handle}">
              ${img}
              <span class="av-sfapi__card-title">${node.title}</span>
              <span class="av-sfapi__card-price">${money(price.amount, price.currencyCode)}</span>
            </a>`;
        })
        .join('');

      statusEl.hidden = true;
      gridEl.hidden = false;
    })
    .catch((err) => {
      console.error('[av-storefront-api]', err);
      statusEl.textContent =
        'Could not load products from the Storefront API. Check the token and API version. (' +
        err.message + ')';
    });
})();
</script>

{% schema %}
{
  "name": "AV Storefront API",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loaded via Storefront API"
    },
    {
      "type": "paragraph",
      "content": "Demonstrates fetching products client-side with the Shopify Storefront API (GraphQL + fetch). Create a custom app, enable Storefront API product read access, and paste the public token below."
    },
    {
      "type": "text",
      "id": "storefront_api_token",
      "label": "Storefront API token",
      "info": "Public Storefront API access token from your custom app."
    },
    {
      "type": "text",
      "id": "api_version",
      "label": "API version",
      "default": "2024-10"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to load",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "AV Storefront API"
    }
  ]
}
{% endschema %}
