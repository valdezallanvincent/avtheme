        "review_2": {
          "type": "testimonial",
          "settings": {
            "author_name": "John Reyes",
            "author_title": "Verified buyer",
            "quote": "Fast shipping and the product exceeded my expectations. Highly recommend!",
            "rating": 5,
            "show_stars": true
          }
        },
        "review_3": {
          "type": "testimonial",
          "settings": {
            "author_name": "Anna Cruz",
            "author_title": "Verified buyer",
            "quote": "Great customer service and amazing product. 10/10.",
            "rating": 4,
            "show_stars": true
          }
        }
      },
      "block_order": ["review_1", "review_2", "review_3"]
