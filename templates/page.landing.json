{
  "sections": {
    "hero_banner": {
      "type": "image-banner",
      "settings": {
        "image_height": "large",
        "adapt_height_first_image": false,
        "show_text_below": false,
        "show_text_box": true,
        "desktop_content_position": "middle-center",
        "content_alignment": "center",
        "color_scheme": "scheme-1",
        "image_behavior": "none"
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Welcome to Our Store",
            "heading_size": "h0"
          }
        },
        "subheading": {
          "type": "subheading",
          "settings": {
            "subheading": "Discover our best products"
          }
        },
        "cta": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Shop Now",
            "button_link_1": "/collections/all",
            "button_style_secondary_1": false,
            "button_label_2": "Learn More",
            "button_link_2": "",
            "button_style_secondary_2": true
          }
        }
      },
      "block_order": ["subheading", "heading", "cta"]
    },
    "featured_collection": {
      "type": "featured-collection",
      "settings": {
        "title": "Featured Products",
        "description": "",
        "show_description": false,
        "description_style": "body",
        "products_to_show": 4,
        "columns_desktop": 4,
        "full_width": false,
        "show_view_all": true,
        "view_all_style": "solid",
        "enable_desktop_slider": false,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "enable_quick_add": true,
        "columns_mobile": "2",
        "swipe_on_mobile": true,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "testimonials": {
      "type": "custom-testimonials",
      "settings": {
        "heading": "What Our Customers Say",
